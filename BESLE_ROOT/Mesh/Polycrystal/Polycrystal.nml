! Editable configuration for the polycrystalline mesh generator.
! Edit this file and run run-polycrystal.cmd. Recompilation is not required.
&POLYCRYSTAL_CONFIG
    ngrains_x = 3
    ngrains_y = 4
    ngrains_z = 8

    x_max = 15.0
    y_max = 15.0
    z_max = 45.0

    ! 0: regular centers; 1: random centers within each block.
    stochastic = 0

    ! Triangulation density for each face.
    dm = 1
/
