! Configuracion editable del generador de malla policristalina.
! Edite este archivo y ejecute run-polycrystal.cmd. No se recompila BESLE.
&POLYCRYSTAL_CONFIG
    ngrains_x = 3
    ngrains_y = 4
    ngrains_z = 8

    x_max = 15.0
    y_max = 15.0
    z_max = 45.0

    ! 0: centros regulares; 1: centros aleatorios dentro de cada bloque.
    stochastic = 0

    ! Densidad de la triangulacion de cada cara.
    dm = 1
/
