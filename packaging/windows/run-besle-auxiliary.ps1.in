[CmdletBinding()]
param(
    [Parameter(Mandatory = $true)]
    [ValidateSet("Material", "General", "Polycrystal")]
    [string]$Tool,
    [Parameter(Mandatory = $true)]
    [string]$WorkDirectory,
    [switch]$NoPause
)

$ErrorActionPreference = "Stop"
# Keep framework diagnostics in English; leave numeric parsing culture intact.
[Threading.Thread]::CurrentThread.CurrentUICulture =
    [Globalization.CultureInfo]::GetCultureInfo("en-US")
$version = "@PROJECT_VERSION@"
$appRoot = $PSScriptRoot

function Wait-BesleAuxiliary {
    if (-not $NoPause) {
        [void](Read-Host "Press Enter to close")
    }
}

function Get-UniqueDirectory {
    param(
        [Parameter(Mandatory = $true)] [string]$Parent,
        [Parameter(Mandatory = $true)] [string]$BaseName
    )

    $candidate = Join-Path $Parent $BaseName
    $counter = 1
    while (Test-Path -LiteralPath $candidate) {
        $candidate = Join-Path $Parent "$BaseName-$counter"
        $counter++
    }
    return $candidate
}

function Get-NmlString {
    param(
        [Parameter(Mandatory = $true)] [string]$Text,
        [Parameter(Mandatory = $true)] [string]$Name
    )

    $escapedName = [Regex]::Escape($Name)
    $pattern = '(?im)^\s*{0}\s*=\s*[''"]([^''"]*)[''"]' -f $escapedName
    $match = [Regex]::Match($Text, $pattern)
    if (-not $match.Success) {
        throw "$Name was not found in the NML file."
    }
    return $match.Groups[1].Value.Trim()
}

function Get-NmlInteger {
    param(
        [Parameter(Mandatory = $true)] [string]$Text,
        [Parameter(Mandatory = $true)] [string]$Name
    )

    $escapedName = [Regex]::Escape($Name)
    $match = [Regex]::Match($Text, "(?im)^\s*$escapedName\s*=\s*([+-]?\d+)")
    if (-not $match.Success) {
        throw "No valid integer was found for $Name in the NML file."
    }
    return [int]$match.Groups[1].Value
}

function Get-SafeProjectPath {
    param(
        [Parameter(Mandatory = $true)] [string]$Root,
        [Parameter(Mandatory = $true)] [string]$RelativePath
    )

    $portablePath = $RelativePath.Replace('/', [IO.Path]::DirectorySeparatorChar)
    $candidate = [IO.Path]::GetFullPath((Join-Path $Root $portablePath))
    $rootPath = [IO.Path]::GetFullPath($Root)
    $rootPrefix = $rootPath.TrimEnd('\', '/') + [IO.Path]::DirectorySeparatorChar
    if (-not $candidate.StartsWith($rootPrefix, [StringComparison]::OrdinalIgnoreCase)) {
        throw "The output path must remain inside the project: $RelativePath"
    }
    return $candidate
}

function Archive-PreviousOutput {
    param(
        [Parameter(Mandatory = $true)] [string]$Root,
        [Parameter(Mandatory = $true)] [string]$UsedConfig,
        [Parameter(Mandatory = $true)] [string]$LogPath,
        [Parameter(Mandatory = $true)] [string[]]$OutputPaths,
        [switch]$MoveOutputs
    )

    if (-not (Test-Path -LiteralPath $UsedConfig) -and
        -not (Test-Path -LiteralPath $LogPath)) {
        return
    }

    $historyRoot = Join-Path $Root "history"
    [void](New-Item -ItemType Directory -Path $historyRoot -Force)
    $archiveDirectory = Get-UniqueDirectory `
        -Parent $historyRoot -BaseName (Get-Date -Format "yyyyMMdd-HHmmss")
    [void](New-Item -ItemType Directory -Path $archiveDirectory)

    foreach ($metadata in @($UsedConfig, $LogPath)) {
        if (Test-Path -LiteralPath $metadata) {
            Move-Item -LiteralPath $metadata -Destination $archiveDirectory
        }
    }

    $rootPrefix = ([IO.Path]::GetFullPath($Root)).TrimEnd('\', '/') + `
        [IO.Path]::DirectorySeparatorChar
    foreach ($outputPath in $OutputPaths) {
        if (-not (Test-Path -LiteralPath $outputPath)) {
            continue
        }
        $fullOutput = [IO.Path]::GetFullPath($outputPath)
        if (-not $fullOutput.StartsWith($rootPrefix, [StringComparison]::OrdinalIgnoreCase)) {
            throw "Outputs outside the project will not be archived: $fullOutput"
        }
        $relative = $fullOutput.Substring($rootPrefix.Length)
        $destination = Join-Path (Join-Path $archiveDirectory "outputs") $relative
        $destinationParent = Split-Path -Parent $destination
        [void](New-Item -ItemType Directory -Path $destinationParent -Force)
        if ($MoveOutputs) {
            Move-Item -LiteralPath $fullOutput -Destination $destination
        }
        else {
            Copy-Item -LiteralPath $fullOutput -Destination $destination -Recurse
        }
    }
}

function Invoke-NativeLogged {
    param(
        [Parameter(Mandatory = $true)] [string]$Executable,
        [Parameter(Mandatory = $true)] [string]$LogPath,
        [switch]$Append
    )

    if (-not (Test-Path -LiteralPath $Executable -PathType Leaf)) {
        throw "The auxiliary executable was not found: $Executable"
    }
    if ($Append) {
        & $Executable 2>&1 | Tee-Object -FilePath $LogPath -Append
    }
    else {
        & $Executable 2>&1 | Tee-Object -FilePath $LogPath
    }
    $exitCode = $LASTEXITCODE
    if ($exitCode -ne 0) {
        throw "$([IO.Path]::GetFileName($Executable)) exited with code $exitCode."
    }
}

try {
    $normalizedWorkDirectory = $WorkDirectory.Trim().Trim('"')
    $workRoot = [IO.Path]::GetFullPath($normalizedWorkDirectory)
    if (-not (Test-Path -LiteralPath $workRoot -PathType Container)) {
        throw "The auxiliary folder does not exist: $workRoot."
    }

    $configurationName = "$Tool.nml"
    $configurationPath = Join-Path $workRoot $configurationName
    $usedConfiguration = Join-Path $workRoot "$Tool-used.nml"
    $logPath = Join-Path $workRoot "$Tool.log"
    if (-not (Test-Path -LiteralPath $configurationPath -PathType Leaf)) {
        throw "$configurationName was not found in $workRoot."
    }

    $configText = [IO.File]::ReadAllText($configurationPath)
    $outputPaths = @()
    $moveOutputs = $false

    switch ($Tool) {
        "Material" {
            $fileplace = Get-NmlString -Text $configText -Name "fileplace"
            $fileName = Get-NmlString -Text $configText -Name "file_name"
            $numberOfMaterials = Get-NmlInteger -Text $configText -Name "n_materials"
            if ($numberOfMaterials -lt 1) {
                throw "n_materials must be at least 1."
            }
            if ($numberOfMaterials -eq 1) {
                $relativeOutputs = @(Join-Path $fileplace $fileName)
            }
            else {
                $relativeOutputs = @(0..($numberOfMaterials - 1) | ForEach-Object {
                    Join-Path $fileplace "Mat_$_.dat"
                })
            }
            $outputPaths = @($relativeOutputs | ForEach-Object {
                Get-SafeProjectPath -Root $workRoot -RelativePath $_
            })
            $executable = Join-Path $appRoot "BESLE-Material.exe"
            $environmentName = "BESLE_MATERIAL_CONFIG_FILE"
        }
        "General" {
            $fileName = Get-NmlString -Text $configText -Name "filename_out"
            $numberOfBoundaries = Get-NmlInteger -Text $configText -Name "NumBCS"
            if ($numberOfBoundaries -lt 0) {
                throw "NumBCS must not be negative."
            }
            $meshOutputDirectory = Get-SafeProjectPath `
                -Root $workRoot -RelativePath "Meshes/DAT"
            $boundaryOutputDirectory = Get-SafeProjectPath `
                -Root $workRoot -RelativePath "BCs/BCs_DAT"
            $outputPaths = @($meshOutputDirectory, $boundaryOutputDirectory)
            $expectedOutputs = @(
                Get-SafeProjectPath -Root $workRoot `
                    -RelativePath (Join-Path "Meshes/DAT" $fileName)
            )
            if ($numberOfBoundaries -gt 0) {
                $expectedOutputs += @(1..$numberOfBoundaries | ForEach-Object {
                    Get-SafeProjectPath -Root $workRoot `
                        -RelativePath "BCs/BCs_DAT/BCs_$_.dat"
                })
            }
            $moveOutputs = $true
            $executable = Join-Path $appRoot "BESLE-General.exe"
            $environmentName = "BESLE_GENERAL_CONFIG_FILE"
        }
        "Polycrystal" {
            $ioDirectory = Get-SafeProjectPath -Root $workRoot -RelativePath "IO_files"
            $exportDirectory = Get-SafeProjectPath -Root $workRoot -RelativePath "Export"
            $outputPaths = @($ioDirectory, $exportDirectory)
            $expectedOutputs = @(
                (Get-SafeProjectPath -Root $workRoot -RelativePath "Export/Mesh.dat"),
                (Get-SafeProjectPath -Root $workRoot -RelativePath "Export/Mesh.vtk")
            )
            $moveOutputs = $true
            $structureExecutable = Join-Path $appRoot "BESLE-Polycrystal-Structure.exe"
            $meshExecutable = Join-Path $appRoot "BESLE-Polycrystal-Mesh.exe"
            $environmentName = "BESLE_POLYCRYSTAL_CONFIG_FILE"
        }
    }

    Archive-PreviousOutput -Root $workRoot -UsedConfig $usedConfiguration `
        -LogPath $logPath -OutputPaths $outputPaths -MoveOutputs:$moveOutputs

    if ($Tool -eq "General") {
        [void](New-Item -ItemType Directory -Path $meshOutputDirectory -Force)
        [void](New-Item -ItemType Directory -Path $boundaryOutputDirectory -Force)
    }
    elseif ($Tool -eq "Material") {
        foreach ($outputPath in $outputPaths) {
            $outputParent = Split-Path -Parent $outputPath
            [void](New-Item -ItemType Directory -Path $outputParent -Force)
        }
    }
    elseif ($Tool -eq "Polycrystal") {
        [void](New-Item -ItemType Directory -Path $ioDirectory -Force)
        [void](New-Item -ItemType Directory -Path $exportDirectory -Force)
    }

    Copy-Item -LiteralPath $configurationPath -Destination $usedConfiguration -Force
    [Environment]::SetEnvironmentVariable($environmentName, $configurationPath, "Process")

    Push-Location $workRoot
    try {
        Write-Host ""
        Write-Host "Running the $Tool auxiliary tool for BESLE $version"
        Write-Host "Folder:       $workRoot"
        Write-Host "Configuration: $configurationPath"
        Write-Host ""
        if ($Tool -eq "Polycrystal") {
            Invoke-NativeLogged -Executable $structureExecutable -LogPath $logPath
            Invoke-NativeLogged -Executable $meshExecutable -LogPath $logPath -Append
        }
        else {
            Invoke-NativeLogged -Executable $executable -LogPath $logPath
        }
    }
    finally {
        Pop-Location
    }

    if ($Tool -eq "Material") {
        $expectedOutputs = $outputPaths
    }
    foreach ($expectedOutput in $expectedOutputs) {
        if (-not (Test-Path -LiteralPath $expectedOutput -PathType Leaf)) {
            throw "The run did not generate the expected output: $expectedOutput"
        }
    }

    Write-Host ""
    Write-Host "$Tool completed successfully."
    Write-Host "Configuration used: $usedConfiguration"
    Write-Host "Log:            $logPath"
    Write-Host ""
    Write-Host "Edit $configurationName and run the same .cmd file again."
    Write-Host "Recompilation is not required. Previous outputs are saved in history."
    Write-Host ""
    Wait-BesleAuxiliary
    exit 0
}
catch {
    Write-Host ""
    Write-Error $_
    Write-Host ""
    Wait-BesleAuxiliary
    exit 1
}
